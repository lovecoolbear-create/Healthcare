  "required": ["name", "type", "config", "nutritionist_id"],
  "permission": {
    "read": true,
    "create": true,
    "update": true,
    "delete": true
  },
  "properties": {
    "name": {
      "bsonType": "string",
      "description": "规则名称"
    },
    "type": {
      "bsonType": "string",
      "description": "规则类型标识"
    },
    "description": {
