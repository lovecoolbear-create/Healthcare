      "description": "规则描述"
    },
    "nutritionist_id": {
      "bsonType": "string",
      "description": "所属营养师ID"
    },
    "enabled": {
      "bsonType": "bool",
      "description": "是否启用"
    },
    "config": {
      "bsonType": "object",
      "description": "规则参数配置"
    },
    "update_date": {
      "bsonType": ["timestamp", "int"]
    }
