{
  "bsonType": "object",
  "required": ["user_id", "item_id", "item_name", "status"],
  "permission": {
    "read": "auth.uid == doc.user_id || auth.role == 'admin'",
    "create": "auth.uid == doc.user_id",
    "update": "auth.role == 'admin'",
    "delete": "auth.role == 'admin'"
  },
  "properties": {
    "_id": { "description": "ID" },
    "user_id": { "bsonType": "string", "description": "用户ID" },
    "item_id": { "bsonType": "string", "description": "产品ID" },
    "item_name": { "bsonType": "string", "description": "产品名称" },
    "status": { "bsonType": "string", "enum": ["pending", "approved", "rejected"], "description": "状态" },
    "created_at": { "bsonType": "timestamp", "defaultValue": { "$env": "now" } }
  }
}