{
  "bsonType": "object",
  "required": ["user_id", "name", "stock", "unit"],
  "permission": {
    "read": "auth.uid == doc.user_id",
    "create": "auth.uid != null",
    "update": "auth.uid == doc.user_id",
    "delete": "auth.uid == doc.user_id"
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "user_id": {
      "bsonType": "string",
      "description": "用户ID"
    },
    "name": {
      "bsonType": "string",
      "description": "产品名称"
    },
    "product_id": {
      "bsonType": "string",
      "description": "产品ID"
    },
    "product_name": {
      "bsonType": "string",
      "description": "产品名称（兼容字段）"
    },
    "stock": {
      "bsonType": "int",
      "description": "剩余库存"
    },
    "capacity": {
      "bsonType": "double",
      "description": "每瓶容量（用于覆盖天数计算）"
    },
    "daily_usage": {
      "bsonType": "double",
      "description": "每日用量（用于覆盖天数计算）"
    },
    "unit": {
      "bsonType": "string",
      "description": "单位"
    },
    "icon": {
      "bsonType": "string",
      "description": "图标emoji"
    },
    "low_stock_days": {
      "bsonType": "double",
      "description": "低库存预警：剩余可用天数阈值",
      "defaultValue": 7
    },
    "low_stock_threshold": {
      "bsonType": "int",
      "description": "低库存预警阈值",
      "defaultValue": 5
    },
    "created_at": {
      "bsonType": "timestamp",
      "description": "创建时间"
    },
    "updated_at": {
      "bsonType": "timestamp",
      "description": "更新时间"
    }
  }
}
