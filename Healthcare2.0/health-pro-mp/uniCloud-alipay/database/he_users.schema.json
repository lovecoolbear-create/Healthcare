{
  "bsonType": "object",
  "required": ["username", "phone", "role"],
  "permission": {
    "read": true,
    "create": true,
    "update": true,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "username": {
      "bsonType": "string",
      "description": "用户名",
      "trim": "both"
    },
    "phone": {
      "bsonType": "string",
      "description": "手机号",
      "pattern": "^1[3-9]\\d{9}$",
      "trim": "both"
    },
    "password": {
      "bsonType": "string",
      "description": "登录密码",
      "trim": "both"
    },
    "role": {
      "bsonType": "string",
      "description": "角色：client-客户, admin-营养师",
      "enum": ["client", "admin"],
      "defaultValue": "client"
    },
    "avatar": {
      "bsonType": "string",
      "description": "头像URL"
    },
    "gender": {
      "bsonType": "string",
      "enum": ["male", "female", "unknown"],
      "description": "性别"
    },
    "age": {
      "bsonType": "int",
      "description": "年龄"
    },
    "tags": {
      "bsonType": "array",
      "description": "标签",
      "items": {
        "bsonType": "string"
      }
    },
    "wrom": {
      "bsonType": "int",
      "description": "WROM健康分"
    },
    "wromTrend": {
      "bsonType": "string",
      "enum": ["up", "down", "stable"],
      "description": "健康分趋势"
    },
    "lastCheckInHours": {
      "bsonType": "int",
      "description": "距离上次打卡小时数"
    },
    "isHandled": {
      "bsonType": "bool",
      "description": "是否已处理"
    },
    "nutritionist_id": {
      "bsonType": "string",
      "description": "所属营养师ID"
    },
    "is_client": {
      "bsonType": "bool",
      "description": "顾问是否同时是客户（双身份）",
      "defaultValue": false
    },
    "inventory_days": {
      "bsonType": "int",
      "description": "库存剩余天数"
    },
    "is_online": {
      "bsonType": "bool",
      "description": "是否在线"
    },
    "health_targets": {
      "bsonType": "object",
      "description": "顾问设定的阶段健康目标",
      "properties": {
        "weight": {
          "bsonType": "string",
          "description": "目标体重 (例如: 60.0 KG)"
        },
        "body_fat": {
          "bsonType": "string",
          "description": "目标体脂率 (例如: < 20%)"
        },
        "glucose": {
          "bsonType": "string",
          "description": "目标血糖 (例如: 4.4-6.1)"
        },
        "visceral_fat": {
          "bsonType": "string",
          "description": "目标内脏脂肪 (例如: < 5)"
        },
        "water_glasses": {
          "bsonType": "int",
          "description": "每日目标饮水杯数 (例如: 8)"
        }
      }
    },
    "created_at": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "defaultValue": {
        "$env": "now"
      }
    }
  }
}
