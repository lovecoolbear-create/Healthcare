# 核心 HTML 页面禁止缓存，确保 PWA 启动时能拉取最新内容
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# PWA 核心配置文件禁止缓存
/manifest-v14.json
  Cache-Control: no-cache, no-store, must-revalidate
  Access-Control-Allow-Origin: *

# Service Worker 禁止缓存
/sw-v14.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# 根路径重定向页面禁止缓存
/
  Cache-Control: no-cache, no-store, must-revalidate
